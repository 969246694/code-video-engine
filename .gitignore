# ---------------------------------------------------------------- 密钥与本地配置
# Maker 项目标记：含 project_id / user_id，属于个人账号信息，绝不入库
.maker-mcp/
.project/
# 任何令牌/凭证
*.pem
*.key
pat.json
tap-auth.json
.credentials*
.env
.env.*

# ---------------------------------------------------------------- 中间产物
build/
output/
preview/

# ---------------------------------------------------------------- 调试残留
# .raw 是逐帧直通管道的临时文件，单文件可达数 GB
*.raw
*.wav
*.mp3
*.log
__pycache__/
*.pyc
.ipynb_checkpoints/

# 逐帧静帧导出（体积大且可重生成，只保留代表作与联络表）
verify/
!verify/cut2/_contact_sheet.png

# ---------------------------------------------------------------- 保留
# 素材（AI 生成的底图）会被版面代码引用，需要入库
!assets/image/*.png
